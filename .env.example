# Copy this file to ".env" and fill in your real key.
# .env is ignored by git, so your key stays private.

# Which LLM provider to use: gemini, openai, or claude
LLM_PROVIDER=gemini

# Which model to use (leave empty to use the provider's default)
LLM_MODEL=

# API keys: you only need the one for the provider you picked
GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Where the Streamlit page finds the backend
BACKEND_URL=http://localhost:8000
